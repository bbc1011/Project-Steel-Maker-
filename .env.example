# ---------------- eBay ----------------
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_MARKETPLACE_ID=EBAY_US

# ---------------- Search ----------------
SEARCH_QUERY=LEGO 501st Clone Trooper
MAX_PRICE_USD=60
MIN_DISCOUNT_PERCENT=30
MAX_RESULTS=20
FIXED_PRICE_ONLY=true

# Prototype market baseline.
# Replace with a real comparable-sales model in a later version.
REFERENCE_MARKET_PRICE_USD=80

# ---------------- AI ----------------
# Leave blank to disable AI automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Maximum images sent per listing.
AI_MAX_IMAGES=4

# ---------------- Runtime ----------------
DATABASE_PATH=deal_finder.db
REQUEST_TIMEOUT_SECONDS=20
